<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon, used from Android 8 onward. The launcher composites these
  layers and masks the result to whatever shape it prefers, so the foreground
  keeps the mark inside the circle every mask is guaranteed to contain.
  The monochrome layer is what themed icons (Android 13+) tint.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
